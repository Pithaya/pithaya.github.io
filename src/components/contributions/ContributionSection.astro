---
import type { Contribution } from "src/types/contribution";
import ContributionCard from "./ContributionCard.astro";

const getRepo = async (owner: string, repo: string): Promise<Contribution> => {
  const isDev = import.meta.env.DEV;

  if (isDev) {
    const data: Contribution = {
      name: "Pithaya",
      description: "Exemple project.",
      tags: ["Astro", "JavaScript", "Web"],
      repo: "https://github.com/pithaya/pithaya",
      image: "https://avatars.githubusercontent.com/u/19533412?v=4",
    };
    return data;
  } else {
    const response = await fetch(
      `https://api.github.com/repos/${owner}/${repo}`,
    );
    const body = await response.json();
    return {
      name: body.name,
      description: body.description,
      repo: body.html_url,
      tags: body.topics,
      image: body.owner.avatar_url,
    };
  }
};

const contributions: Contribution[] = [
  await getRepo("sightread", "sightread"),
  await getRepo("jellyfin", "jellyfin"),
  await getRepo("spicetify", "cli"),
];
---

<section class="mt-8 flex flex-col gap-4">
  <h1 id="contributions" class="text-2xl font-bold">Contributions</h1>

  <div class="flex flex-col gap-4">
    {
      contributions.map((contribution) => (
        <ContributionCard contribution={contribution} />
      ))
    }
  </div>
</section>
